{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gunmatown-api",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "public-api",
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ORIGINS": "https://dbljun-web.github.io,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080",
    "ADMIN_USERNAME": "admin",
    "ADMIN_BOOTSTRAP_PASSWORD": "admin1218",
    "ADMIN_NICKNAME": "관리자"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gunmatown-auth",
      "database_id": "bc87e786-d349-4634-8da7-9055895c95bf",
      "migrations_dir": "migrations"
    }
  ]
  // R2 활성화 후:
  // 1) Dashboard에서 R2 enable
  // 2) wrangler r2 bucket create gunmatown-shop-images
  // 3) 아래 블록을 다시 추가하고 deploy
  // "r2_buckets": [{ "binding": "SHOP_IMAGES", "bucket_name": "gunmatown-shop-images" }]
}
