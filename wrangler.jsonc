{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twon-api",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "public-api",
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ORIGINS": "https://kyungrock.github.io,https://msg1000.com,https://www.msg1000.com,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080",
    "ADMIN_USERNAME": "admin",
    "ADMIN_BOOTSTRAP_PASSWORD": "admin1218",
    "ADMIN_NICKNAME": "관리자"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "msg1000-auth",
      "database_id": "e71b055f-837a-4170-8433-9fbd9d0fe8af",
      "migrations_dir": "migrations"
    }
  ]
}
